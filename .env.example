NODE_ENV=development
PORT=3000

# --- Database / Cache ---
DATABASE_URL=postgresql://intaktok:devpass@localhost:5432/intaktok
REDIS_URL=redis://localhost:6379

# --- JWT ---
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=1800
JWT_REFRESH_TTL=2592000

# --- Kakao OAuth ---
# OPTIONAL: the backend verifies the client-supplied Kakao access token via
# /v2/user/me (Bearer) and does NOT use the REST API key. Only set this if you
# switch to a server-side authorization-code exchange flow.
KAKAO_REST_API_KEY=
KAKAO_USERINFO_URL=https://kapi.kakao.com/v2/user/me

# --- Object Storage (S3-compatible: Cloudflare R2 / AWS S3 / Backblaze B2 / MinIO) ---
# Local default = MinIO (docker-compose). Production = Cloudflare R2 (recommended).
#
# Cloudflare R2 example (private bucket, presigned for everything — most secure):
#   S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   S3_BUCKET=intaktok-media
#   S3_ACCESS_KEY=<R2 Access Key ID>
#   S3_SECRET_KEY=<R2 Secret Access Key>
#   S3_REGION=auto
#   S3_FORCE_PATH_STYLE=true
#   S3_PUBLIC_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   CDN_BASE_URL=          # leave EMPTY -> avatars/thumbnails are served via presigned GET too
#
# Optional: to serve avatars/thumbnails as plain public URLs (CDN), enable R2 public
# access (r2.dev) or a custom domain and set CDN_BASE_URL to it. Note this makes the
# whole bucket publicly readable by key (message media included) — trade-off.
#   CDN_BASE_URL=https://pub-<hash>.r2.dev      # or https://cdn.yourdomain.com
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=intaktok-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_ENDPOINT=http://localhost:9000
CDN_BASE_URL=

# --- Push (FCM) ---
# Option A (PaaS/Railway): inline credentials as raw JSON or base64 (no file to commit).
FCM_SERVICE_ACCOUNT=
# Option B (local/dev): path to a Firebase service-account JSON file.
# Leave both empty to disable push (no-op).
FCM_SERVICE_ACCOUNT_JSON=./secrets/fcm.json

# --- Policy defaults (see README) ---
MESSAGE_UNSEND_WINDOW_SEC=300
MEDIA_MAX_BYTES=52428800
PRESENCE_TTL_SEC=60
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Rate limits (requests per window) ---
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# --- Admin RBAC ---
# Comma-separated list of userIds OR kakaoIds granted ADMIN console access.
ADMIN_USER_IDS=

# --- Whitelist bootstrap (closed-platform chicken & egg) ---
# Comma-separated kakaoIds auto-registered as INVITED at boot (idempotent;
# never re-activates BLOCKED entries). Put your own kakaoId here for the first
# login, then manage members via POST /api/v1/admin/whitelist.
WHITELIST_BOOTSTRAP_KAKAO_IDS=
