NODE_ENV=development
PORT=3000

# --- Database / Cache ---
DATABASE_URL=postgresql://intaktok:devpass@localhost:5432/intaktok
REDIS_URL=redis://localhost:6379

# --- JWT ---
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=1800
JWT_REFRESH_TTL=2592000

# --- Kakao OAuth ---
KAKAO_REST_API_KEY=your-kakao-rest-api-key
KAKAO_USERINFO_URL=https://kapi.kakao.com/v2/user/me

# --- Object Storage (S3-compatible: AWS S3 / Cloudflare R2 / Backblaze B2 / MinIO) ---
# Railway has no built-in object storage — point these at an external S3-compatible
# provider in production. For Cloudflare R2: set S3_ENDPOINT to the R2 endpoint,
# S3_FORCE_PATH_STYLE=true, S3_REGION=auto, and CDN_BASE_URL to the R2 public/custom domain.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=intaktok-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_ENDPOINT=http://localhost:9000
CDN_BASE_URL=

# --- Push (FCM) ---
# Option A (PaaS/Railway): inline credentials as raw JSON or base64 (no file to commit).
FCM_SERVICE_ACCOUNT=
# Option B (local/dev): path to a Firebase service-account JSON file.
# Leave both empty to disable push (no-op).
FCM_SERVICE_ACCOUNT_JSON=./secrets/fcm.json

# --- Policy defaults (see README) ---
MESSAGE_UNSEND_WINDOW_SEC=300
MEDIA_MAX_BYTES=52428800
PRESENCE_TTL_SEC=60
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Rate limits (requests per window) ---
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# --- Admin RBAC ---
# Comma-separated list of userIds (or kakaoIds) granted ADMIN console access.
ADMIN_USER_IDS=
