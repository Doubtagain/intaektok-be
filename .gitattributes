# Normalize line endings to LF in the repo (Linux Docker build / cross-platform).
* text=auto eol=lf

# Keep shell-interpreted / config files as LF explicitly.
*.ts text eol=lf
*.js text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.prisma text eol=lf
*.sql text eol=lf
*.toml text eol=lf
Dockerfile text eol=lf
*.sh text eol=lf

# Binary assets (never normalize).
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
